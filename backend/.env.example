# DocuMind AI Backend Environment Configuration

# Google Gemini API Key (Required for live embeddings and generation)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8001
SECRET_KEY=change_this_to_a_secure_random_string_for_production_sessions

# CORS Settings (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Paths (Relative to backend directory or absolute paths)
STORAGE_DIR=./storage
UPLOADS_DIR=./storage/uploads
CHROMA_DIR=./storage/chroma
DATABASE_URL=sqlite:///./storage/documind.db

# Ingestion and Retrieval Parameters
DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=5
RELEVANCE_THRESHOLD=0.65
MAX_FILE_SIZE_MB=20

# AI Model Configuration
EMBEDDING_MODEL=gemini-embedding-001
GENERATION_MODEL=gemini-2.5-flash

